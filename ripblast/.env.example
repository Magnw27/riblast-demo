# Database Postgres (Neon). Otomatis terisi kalau kamu connect Neon dari Vercel > Storage.
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID admin (kirim /start ke bot untuk melihat ID-nya). Boleh lebih dari satu, pisah dengan koma.
TELEGRAM_ADMIN_CHAT_ID=123456789

# Kode rahasia bebas (huruf, angka, _ atau -). Dipakai untuk mengamankan webhook.
TELEGRAM_WEBHOOK_SECRET=ganti_dengan_kode_acak_panjang

# Opsional: paksa URL situs, mis. https://ripblast.vercel.app (default: otomatis dari domain)
# SITE_URL=
